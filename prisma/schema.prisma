generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================
// AGENTIC MINER — Game Database Schema
// Token: AGENMINER (BEP-20 di BNB Smart Chain)
// ============================================

model User {
  id            String       @id @default(cuid())
  walletAddress String       @unique // alamat wallet BNB Chain (lowercase)
  agentId       String?      @unique // Binance Agent ID — dipakai sebagai username & invite code
  verifiedAgent Boolean      @default(false) // true = Agent ID ASLI Binance via QR pairing (kecepatan mining penuh)
  username      String? // nama penambang
  avatar        String       @default("🤖") // emoji avatar
  balance       Float        @default(0) // saldo AGENMINER tersedia
  totalMined    Float        @default(0) // total AGENMINER yang pernah ditambang
  miningPower   Int          @default(1) // level rig → multiplier reward
  streak        Int          @default(0) // streak aktivitas harian
  lastMineAt    DateTime? // cooldown mining terakhir
  lastActiveDate String? // tanggal aktivitas terakhir (yyyy-mm-dd) untuk streak
  lastCheckin   String? // tanggal check-in harian terakhir (yyyy-mm-dd)
  refCode       String       @unique // kode referral unik
  referredById  String? // User.id dari pengundang
  refEarnings   Float        @default(0) // total komisi referral
  createdAt     DateTime     @default(now())

  mines       MineLog[]
  withdrawals Withdrawal[]
  upgrades    UpgradeLog[]

  @@index([totalMined])
  @@index([refCode])
}

model MineLog {
  id        String   @id @default(cuid())
  userId    String
  prompt    String // prompt AI yang dikirim penambang
  score     Int // skor evaluasi AI (0-100)
  reward    Float // AGENMINER didapat
  aiSummary String? // narasi hasil tambang dari AI
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// ============================================
// DAUR ULANG POOL — setiap upgrade Mining Power membakar token dari
// saldo wallet, dan jumlah bakaran ini DIKREDITKAN KEMBALI ke pool
// mining 70.000.000 (lihat poolRemaining di /api/stats & /api/mine).
// Cap pribadi 7.000/wallet TETAP berdasar totalMined (tidak pernah
// turun) → tidak ada celah tambang ulang tanpa batas.
// ============================================
model UpgradeLog {
  id        String   @id @default(cuid())
  userId    String
  fromPower Int // Mining Power sebelum upgrade
  toPower   Int // Mining Power setelah upgrade
  cost      Float // token terbakar — didaur ulang ke pool 70M
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
}

model Withdrawal {
  id          String    @id @default(cuid())
  userId      String
  amount      Float // total AGENMINER ditarik dari saldo
  fee         Float     @default(0) // bagian fee → likuiditas PancakeSwap
  netAmount   Float     @default(0) // jumlah di-mint otomatis ke wallet user
  status      String    @default("PENDING") // PENDING | PROCESSED (MINTED) | REJECTED
  txHash      String? // hash tx mint on-chain (diisi saat kontrak aktif)
  mintMode    String    @default("AUTO") // AUTO = mint otomatis oleh backend
  createdAt   DateTime  @default(now())
  processedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  liquidityLogs LiquidityLog[]

  @@index([userId, createdAt])
}

// Ledger fee penarikan yang masuk ke likuiditas DEX PancakeSwap
model LiquidityLog {
  id           String   @id @default(cuid())
  withdrawalId String?
  amount       Float // jumlah AGENMINER masuk likuiditas
  dex          String   @default("PancakeSwap V2")
  pairAddress  String? // pair AGENMINER/BNB
  note         String?
  createdAt    DateTime @default(now())

  withdrawal Withdrawal? @relation(fields: [withdrawalId], references: [id], onDelete: SetNull)

  @@index([createdAt])
}
